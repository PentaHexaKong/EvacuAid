# Root Compose settings. Copy to .env (never commit it).
# Fixes the Compose project name, so volumes are always evacuaid_postgres_data / evacuaid_valhalla_tiles
# whatever the checkout folder is called.
COMPOSE_PROJECT_NAME=evacuaid

# Database credentials for the postgres container. The defaults are for local development only.
POSTGRES_DB=evacuaid
POSTGRES_USER=evacuaid
POSTGRES_PASSWORD=change-me

# Lets the Command Center raise mock disasters that reach phones as warnings (1 = on).
COMMAND_MOCK_ALERTS_ENABLED=1
# Optional shared key for command routes. Empty = open, as in the demo.
COMMAND_API_KEY=

# Public Mapbox token (pk.*) for the Command Center map, the same one the app uses. Empty = no basemap.
MAPBOX_TOKEN=
