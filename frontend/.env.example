# Pick the address for the target device:
# Android emulator: http://10.0.2.2:8000
# iOS simulator: http://localhost:8000
# Physical iPhone: http://<your-computer-LAN-IPv4>:8000 (same Wi-Fi)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
ANDROID_GOOGLE_MAPS_API_KEY=
IOS_BUNDLE_IDENTIFIER=dev.evacuaid.foundation
ANDROID_PACKAGE=dev.evacuaid.foundation
# Mapbox public token (pk.*) for development builds. Leave empty to use react-native-maps everywhere.
EXPO_PUBLIC_MAPBOX_TOKEN=
# Optional Mapbox Studio style URL. Defaults to Mapbox Light.
EXPO_PUBLIC_MAPBOX_STYLE_URL=
